#pragma kernel ComputeDensityLambda
#pragma kernel ComputeDeltaPosition
#pragma kernel ApplyDeltaPosition
#pragma kernel ApplyTensileDeltaPosition
#pragma kernel UpdateVelocities
#pragma kernel ComputeCohesionDeltaVelocities
#pragma kernel ComputeXsphDeltaVelocities
#pragma kernel ApplyDeltaVelocities
#pragma kernel ComputeVorticities
#pragma kernel ComputeVorticityDeltaVelocities
#pragma kernel ClampVelocities

#include "FluidGpuCommon.hlsl"

// 每个 Kernel 只绑定它实际读写的 Buffer。尤其 D3D11 同一 Kernel 最多 8 个 RW UAV，
// 所有邻居读取 Buffer 均保持 StructuredBuffer，避免为方便而把整套 SoA 都绑成 UAV。
StructuredBuffer<float4> _Positions;
RWStructuredBuffer<float4> _PredictedPositions;
RWStructuredBuffer<float4> _Velocities;
RWStructuredBuffer<float2> _DensityLambda;
StructuredBuffer<uint2> _ParticleMetadata;
RWStructuredBuffer<float4> _DeltaPositions;
RWStructuredBuffer<float4> _DeltaVelocities;
RWStructuredBuffer<float4> _Vorticities;
StructuredBuffer<uint2> _SpatialEntries;
StructuredBuffer<uint2> _CellRanges;
StructuredBuffer<int4> _SpatialCells;
StructuredBuffer<FluidGpuLiquidMaterialParameters> _LiquidMaterialParameters;
RWStructuredBuffer<uint> _Counters;

int _ParticleCapacity;
int _HashTableCapacity;
float _SmoothingRadius;
float _ParticleMass;
float _RestDensity;
float _LambdaEpsilon;
float _ArtificialPressure;
float _MaximumPositionCorrection;
float _TensileStrength;
float _MaximumTensilePositionCorrection;
float _DeltaTime;
float _Viscosity;
float _Vorticity;
float _CohesionStrength;
float _CohesionRestDistance;
float _MaximumCohesionDeltaSpeed;
float _MaxSpeed;

static const uint FLUID_INACTIVE_BUCKET = 0xffffffffu;
static const float FLUID_PI = 3.14159265359f;
static const float FLUID_DIRECTION_EPSILON_SQUARED = 1e-12f;
static const float FLUID_ARTIFICIAL_PRESSURE_RATIO = 0.3f;

bool IsFiniteFloat(float value)
{
    // IEEE 754 的 exponent 全为 1 代表 NaN 或 Infinity。直接检查 bit pattern，
    // 避免 D3D fast-math 把 isnan/isinf 当成恒 false 并产生无意义 warning。
    return (asuint(value) & 0x7f800000u) != 0x7f800000u;
}

bool IsFiniteFloat3(float3 value)
{
    return IsFiniteFloat(value.x) && IsFiniteFloat(value.y) && IsFiniteFloat(value.z);
}

float PositiveCubeRoot(float value)
{
    // log2/exp2 只在正数域内求分数次幂；0 单独返回，既保持数学语义，也消除
    // 通用幂函数对负底数的保守编译警告。
    return value > 0.0f ? exp2(log2(value) / 3.0f) : 0.0f;
}

FluidGpuLiquidMaterialParameters ResolveMaterialParameters(uint particleIndex)
{
    FluidGpuLiquidMaterialParameters value =
        _LiquidMaterialParameters[_ParticleMetadata[particleIndex].x];
    // 旧 GPU fixture 会绕过 Production Spawn Adapter 直接写粒子且不上传参数表。
    // Production 对无 Row Material 会在 CPU 边界拒绝；这里的 fallback 仅保持既有 fixture 可诊断。
    if (value.massDensityViscosityPressure.x <= 0.0f
        || value.massDensityViscosityPressure.y <= 0.0f)
    {
        float restSpacing = PositiveCubeRoot(
            max(_ParticleMass, 0.0f) / max(_RestDensity, 1e-6f));
        value.massDensityViscosityPressure = float4(
            _ParticleMass,
            _RestDensity,
            _Viscosity,
            _ArtificialPressure);
        value.cohesionAndSleep = float4(
            _CohesionStrength,
            _CohesionRestDistance / max(restSpacing, 1e-6f),
            _MaximumCohesionDeltaSpeed,
            0.02f);
    }
    return value;
}

void RecordNumericalError()
{
    uint ignored;
    InterlockedAdd(_Counters[FLUID_NUMERICAL_ERROR_COUNTER], 1u, ignored);
}

bool IsActive(uint particleIndex)
{
    return particleIndex < (uint)_ParticleCapacity
        && FluidRequiresSimulation(_ParticleMetadata[particleIndex].y)
        && _PredictedPositions[particleIndex].w > 0.5f;
}

uint HashCell(int3 cell)
{
    uint hash = (uint)cell.x * 73856093u;
    hash ^= (uint)cell.y * 19349663u;
    hash ^= (uint)cell.z * 83492791u;
    return hash & (uint)(_HashTableCapacity - 1);
}

float Poly6(float distance)
{
    if (distance < 0.0f || distance >= _SmoothingRadius || !IsFiniteFloat(distance))
        return 0.0f;

    float h2 = _SmoothingRadius * _SmoothingRadius;
    float difference = h2 - distance * distance;
    float h4 = h2 * h2;
    float h8 = h4 * h4;
    float h9 = h8 * _SmoothingRadius;
    return 315.0f / (64.0f * FLUID_PI * h9) * difference * difference * difference;
}

float3 SpikyGradient(float3 offset)
{
    float distanceSquared = dot(offset, offset);
    if (!IsFiniteFloat3(offset) || distanceSquared <= FLUID_DIRECTION_EPSILON_SQUARED)
        return 0.0f;

    float distance = sqrt(distanceSquared);
    if (distance >= _SmoothingRadius)
        return 0.0f;

    float h2 = _SmoothingRadius * _SmoothingRadius;
    float h6 = h2 * h2 * h2;
    float surfaceDistance = _SmoothingRadius - distance;
    float coefficient = -45.0f / (FLUID_PI * h6);
    return coefficient * surfaceDistance * surfaceDistance * (offset / distance);
}

float ArtificialPressure(float distance, float artificialPressure)
{
    if (artificialPressure <= 0.0f || distance >= _SmoothingRadius)
        return 0.0f;

    // sCorr 的 ratio 截断到 1，保证该项位于 [-ArtificialPressure, 0]，而非在重合时无界放大。
    float denominator = max(Poly6(FLUID_ARTIFICIAL_PRESSURE_RATIO * _SmoothingRadius), 1e-6f);
    float ratio = saturate(Poly6(distance) / denominator);
    return -artificialPressure * ratio * ratio * ratio * ratio;
}

bool TryGetNeighbor(uint sortedIndex, int3 requiredCell, uint targetParticleIndex, out uint neighborIndex)
{
    neighborIndex = 0u;
    if (sortedIndex >= (uint)_ParticleCapacity)
        return false;

    uint2 entry = _SpatialEntries[sortedIndex];
    if (entry.x != HashCell(requiredCell) || entry.y >= (uint)_ParticleCapacity)
        return false;

    float4 candidatePosition = _PredictedPositions[entry.y];
    int4 candidateCell = _SpatialCells[entry.y];
    // Hash 已收录所有 Alive。Remote target 既要和同批远程粒子聚合，也要把已经落稳的
    // Resident 水滩当作静态密度邻居；只有 target 是否推进才由 IsActive/RequiresSimulation 决定。
    if (!FluidIsAlive(_ParticleMetadata[entry.y].y)
        || _ParticleMetadata[entry.y].x != _ParticleMetadata[targetParticleIndex].x
        || candidatePosition.w <= 0.5f
        || candidateCell.w == 0
        || !IsFiniteFloat3(candidatePosition.xyz))
    {
        return false;
    }

    // 这里必须消费 Build 时写入的 snapshot，而不是 Apply 后再 Floor 当前 Position：
    // 同一 Substep 只 Sort 一次时，当前 cell 已变化会与旧 Range 失配，错误地丢失 self/邻居。
    if (any(candidateCell.xyz != requiredCell))
        return false;

    neighborIndex = entry.y;
    return true;
}

bool TryGetSpatialCell(uint particleIndex, out int3 cell)
{
    cell = int3(0, 0, 0);
    if (particleIndex >= (uint)_ParticleCapacity)
        return false;

    int4 snapshot = _SpatialCells[particleIndex];
    if (snapshot.w == 0)
        return false;

    cell = snapshot.xyz;
    return true;
}

[numthreads(64, 1, 1)]
void ComputeDensityLambda(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float particleMass = material.massDensityViscosityPressure.x;
    float restDensity = material.massDensityViscosityPressure.y;

    float3 position = _PredictedPositions[particleIndex].xyz;
    if (!IsFiniteFloat3(position))
    {
        _DensityLambda[particleIndex] = float2(0.0f, 0.0f);
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _DensityLambda[particleIndex] = float2(0.0f, 0.0f);
        RecordNumericalError();
        return;
    }
    float density = 0.0f;
    float3 gradientI = 0.0f;
    float gradientSumSquared = 0.0f;

    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(
            cellOffsetIndex % 3 - 1,
            (cellOffsetIndex / 3) % 3 - 1,
            cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex))
                continue;

            float3 offset = position - _PredictedPositions[neighborIndex].xyz;
            float distance = length(offset);
            density += particleMass * Poly6(distance);
            if (neighborIndex == particleIndex)
                continue;

            float3 gradientJ = -(particleMass / restDensity) * SpikyGradient(offset);
            gradientI -= gradientJ;
            gradientSumSquared += dot(gradientJ, gradientJ);
        }
    }

    gradientSumSquared += dot(gradientI, gradientI);
    // Free Surface 外侧没有邻居，Density 低于 Rest Density 是离散 SPH 的正常边界现象。
    // 只约束正 Compression，避免欠密度产生巨大正 Lambda 并在边缘反复吸引/回弹；
    // 连续水团的聚合职责已经由后续有界 Cohesion Pass 承担。
    float compressionConstraint = max(density / restDensity - 1.0f, 0.0f);
    float lambda = -compressionConstraint / (gradientSumSquared + _LambdaEpsilon);
    if (!IsFiniteFloat(density) || !IsFiniteFloat(lambda))
    {
        _DensityLambda[particleIndex] = float2(0.0f, 0.0f);
        RecordNumericalError();
        return;
    }

    _DensityLambda[particleIndex] = float2(density, lambda);
}

[numthreads(64, 1, 1)]
void ComputeDeltaPosition(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float restDensity = material.massDensityViscosityPressure.y;
    float artificialPressure = material.massDensityViscosityPressure.w;

    float3 position = _PredictedPositions[particleIndex].xyz;
    float lambdaI = _DensityLambda[particleIndex].y;
    if (!IsFiniteFloat3(position) || !IsFiniteFloat(lambdaI))
    {
        _DeltaPositions[particleIndex] = 0.0f;
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _DeltaPositions[particleIndex] = 0.0f;
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }
    float3 deltaPosition = 0.0f;
    float3 tensileDeltaPosition = 0.0f;
    float densityI = _DensityLambda[particleIndex].x;
    float densityDeficitI = saturate(1.0f - densityI / restDensity);

    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(
            cellOffsetIndex % 3 - 1,
            (cellOffsetIndex / 3) % 3 - 1,
            cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex)
                || neighborIndex == particleIndex)
            {
                continue;
            }

            float3 offset = position - _PredictedPositions[neighborIndex].xyz;
            float lambdaJ = _DensityLambda[neighborIndex].y;
            float densityJ = _DensityLambda[neighborIndex].x;
            float3 gradient = SpikyGradient(offset);
            deltaPosition += (lambdaI + lambdaJ + ArtificialPressure(length(offset), artificialPressure))
                * gradient / restDensity;
            // 与主 Lambda 分离：只有欠密度自由表面获得极弱吸引；达到 RestDensity 后严格为 0。
            float densityDeficitJ = saturate(1.0f - densityJ / restDensity);
            float tensilePressure = _TensileStrength
                * 0.5f * (densityDeficitI + densityDeficitJ);
            tensileDeltaPosition += tensilePressure * gradient / restDensity;
        }
    }

    if (!IsFiniteFloat3(deltaPosition)
        || !IsFiniteFloat3(tensileDeltaPosition)
        || !IsFiniteFloat(densityI))
    {
        _DeltaPositions[particleIndex] = 0.0f;
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    float tensileLength = length(tensileDeltaPosition);
    if (_TensileStrength <= 0.0f)
    {
        tensileDeltaPosition = 0.0f;
    }
    else if (!IsFiniteFloat(_MaximumTensilePositionCorrection)
        || _MaximumTensilePositionCorrection <= 0.0f)
    {
        tensileDeltaPosition = 0.0f;
        RecordNumericalError();
    }
    else if (tensileLength > _MaximumTensilePositionCorrection && tensileLength > 0.0f)
    {
        tensileDeltaPosition *= _MaximumTensilePositionCorrection / tensileLength;
    }

    // 复用速度阶段尚未消费的 DeltaVelocities 作为第二个私有 Position Delta，避免新增常驻 GPU Buffer。
    // 两个 Delta 都在后续独立 Dispatch Apply，不能在邻居循环里直接写 PredictedPositions。
    _DeltaPositions[particleIndex] = float4(deltaPosition, 0.0f);
    _DeltaVelocities[particleIndex] = float4(tensileDeltaPosition, 0.0f);
}

[numthreads(64, 1, 1)]
void ApplyDeltaPosition(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    float3 correction = _DeltaPositions[particleIndex].xyz;
    float3 position = _PredictedPositions[particleIndex].xyz;
    bool numericalError = !IsFiniteFloat3(correction) || !IsFiniteFloat3(position);
    if (numericalError)
    {
        _DeltaPositions[particleIndex] = 0.0f;
        _PredictedPositions[particleIndex] = float4(
            IsFiniteFloat3(position) ? position : 0.0f,
            1.0f);
        RecordNumericalError();
        return;
    }

    float correctionLength = length(correction);
    if (correctionLength > _MaximumPositionCorrection && correctionLength > 0.0f)
        correction *= _MaximumPositionCorrection / correctionLength;

    float3 correctedPosition = position + correction;
    if (!IsFiniteFloat3(correctedPosition))
    {
        _DeltaPositions[particleIndex] = 0.0f;
        _PredictedPositions[particleIndex] = float4(position, 1.0f);
        RecordNumericalError();
        return;
    }

    _PredictedPositions[particleIndex] = float4(correctedPosition, 1.0f);
}

[numthreads(64, 1, 1)]
void ApplyTensileDeltaPosition(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    float3 correction = _DeltaVelocities[particleIndex].xyz;
    float3 position = _PredictedPositions[particleIndex].xyz;
    if (!IsFiniteFloat3(correction) || !IsFiniteFloat3(position))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        _PredictedPositions[particleIndex] = float4(
            IsFiniteFloat3(position) ? position : 0.0f,
            1.0f);
        RecordNumericalError();
        return;
    }

    // Compute 阶段已截断；Apply 再做一次防御式上限，避免错误绑定参数突破安全边界。
    float correctionLength = length(correction);
    if (correctionLength > _MaximumTensilePositionCorrection && correctionLength > 0.0f)
        correction *= _MaximumTensilePositionCorrection / correctionLength;

    float3 correctedPosition = position + correction;
    if (!IsFiniteFloat3(correctedPosition))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        _PredictedPositions[particleIndex] = float4(position, 1.0f);
        RecordNumericalError();
        return;
    }

    _PredictedPositions[particleIndex] = float4(correctedPosition, 1.0f);
}

[numthreads(64, 1, 1)]
void UpdateVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    float3 oldPosition = _Positions[particleIndex].xyz;
    float3 predictedPosition = _PredictedPositions[particleIndex].xyz;
    float3 velocity = (predictedPosition - oldPosition) / _DeltaTime;
    if (_DeltaTime <= 0.0f || !IsFiniteFloat3(oldPosition) || !IsFiniteFloat3(predictedPosition)
        || !IsFiniteFloat3(velocity))
    {
        _Velocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _Velocities[particleIndex] = float4(velocity, 0.0f);
}

[numthreads(64, 1, 1)]
void ComputeCohesionDeltaVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float cohesionStrength = material.cohesionAndSleep.x;
    float cohesionRestDistance = PositiveCubeRoot(
        max(material.massDensityViscosityPressure.x, 0.0f)
            / max(material.massDensityViscosityPressure.y, 1e-6f))
        * material.cohesionAndSleep.y;
    float maximumCohesionDeltaSpeed = material.cohesionAndSleep.z;

    float3 position = _PredictedPositions[particleIndex].xyz;
    if (!IsFiniteFloat3(position)
        || !IsFiniteFloat(cohesionRestDistance)
        || cohesionRestDistance < 0.0f
        || cohesionRestDistance >= _SmoothingRadius)
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    float3 weightedDirection = 0.0f;
    float weightSum = 0.0f;
    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(
            cellOffsetIndex % 3 - 1,
            (cellOffsetIndex / 3) % 3 - 1,
            cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex)
                || neighborIndex == particleIndex)
            {
                continue;
            }

            float3 neighborPosition = _PredictedPositions[neighborIndex].xyz;
            float neighborDensity = _DensityLambda[neighborIndex].x;
            float3 offset = neighborPosition - position;
            float distance = length(offset);
            if (!IsFiniteFloat3(neighborPosition)
                || !IsFiniteFloat(neighborDensity)
                || !IsFiniteFloat(distance))
            {
                _DeltaVelocities[particleIndex] = 0.0f;
                RecordNumericalError();
                return;
            }
            if (distance <= cohesionRestDistance || distance >= _SmoothingRadius)
                continue;

            float q = (distance - cohesionRestDistance)
                / (_SmoothingRadius - cohesionRestDistance);
            float weight = 4.0f * q * (1.0f - q);
            weightedDirection += (offset / distance) * weight;
            weightSum += weight;
        }
    }

    float3 acceleration = weightSum > 1e-6f
        ? cohesionStrength * weightedDirection / weightSum
        : 0.0f;
    float3 deltaVelocity = acceleration * _DeltaTime;
    float deltaSpeed = length(deltaVelocity);
    if (deltaSpeed > maximumCohesionDeltaSpeed && deltaSpeed > 0.0f)
        deltaVelocity *= maximumCohesionDeltaSpeed / deltaSpeed;

    if (!IsFiniteFloat3(weightedDirection)
        || !IsFiniteFloat(weightSum)
        || !IsFiniteFloat3(deltaVelocity))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _DeltaVelocities[particleIndex] = float4(deltaVelocity, 0.0f);
}

[numthreads(64, 1, 1)]
void ComputeXsphDeltaVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float particleMass = material.massDensityViscosityPressure.x;
    float viscosity = material.massDensityViscosityPressure.z;

    float3 position = _PredictedPositions[particleIndex].xyz;
    float3 velocity = _Velocities[particleIndex].xyz;
    if (!IsFiniteFloat3(position) || !IsFiniteFloat3(velocity))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }
    float3 deltaVelocity = 0.0f;
    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(cellOffsetIndex % 3 - 1, (cellOffsetIndex / 3) % 3 - 1, cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex) || neighborIndex == particleIndex)
                continue;

            float3 neighborVelocity = _Velocities[neighborIndex].xyz;
            float neighborDensity = _DensityLambda[neighborIndex].x;
            if (!IsFiniteFloat3(neighborVelocity) || !IsFiniteFloat(neighborDensity)
                || neighborDensity <= 1e-6f)
            {
                continue;
            }

            float distance = length(position - _PredictedPositions[neighborIndex].xyz);
            // 标准 XSPH：c * (m_j/rho_j) * (v_j-v_i) * W。rho 来自本轮 Density Kernel，
            // 不能偷用 RestDensity，否则不同密度区域会得到错误的平滑尺度。
            deltaVelocity += viscosity * (particleMass / neighborDensity)
                * (neighborVelocity - velocity) * Poly6(distance);
        }
    }

    if (!IsFiniteFloat3(deltaVelocity))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _DeltaVelocities[particleIndex] = float4(deltaVelocity, 0.0f);
}

[numthreads(64, 1, 1)]
void ApplyDeltaVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    float3 velocity = _Velocities[particleIndex].xyz;
    float3 deltaVelocity = _DeltaVelocities[particleIndex].xyz;
    float3 correctedVelocity = velocity + deltaVelocity;
    if (!IsFiniteFloat3(velocity) || !IsFiniteFloat3(deltaVelocity) || !IsFiniteFloat3(correctedVelocity))
    {
        _Velocities[particleIndex] = 0.0f;
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _Velocities[particleIndex] = float4(correctedVelocity, 0.0f);
}

[numthreads(64, 1, 1)]
void ComputeVorticities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float particleMass = material.massDensityViscosityPressure.x;

    float3 position = _PredictedPositions[particleIndex].xyz;
    float3 velocity = _Velocities[particleIndex].xyz;
    if (!IsFiniteFloat3(position) || !IsFiniteFloat3(velocity))
    {
        _Vorticities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _Vorticities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }
    float3 vorticity = 0.0f;
    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(cellOffsetIndex % 3 - 1, (cellOffsetIndex / 3) % 3 - 1, cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex) || neighborIndex == particleIndex)
                continue;

            float neighborDensity = _DensityLambda[neighborIndex].x;
            float3 neighborVelocity = _Velocities[neighborIndex].xyz;
            if (!IsFiniteFloat(neighborDensity) || neighborDensity <= 1e-6f
                || !IsFiniteFloat3(neighborVelocity))
            {
                continue;
            }

            float3 offset = position - _PredictedPositions[neighborIndex].xyz;
            vorticity += (particleMass / neighborDensity)
                * cross(neighborVelocity - velocity, SpikyGradient(offset));
        }
    }

    if (!IsFiniteFloat3(vorticity))
    {
        _Vorticities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _Vorticities[particleIndex] = float4(vorticity, 0.0f);
}

[numthreads(64, 1, 1)]
void ComputeVorticityDeltaVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    FluidGpuLiquidMaterialParameters material = ResolveMaterialParameters(particleIndex);
    float particleMass = material.massDensityViscosityPressure.x;

    float3 position = _PredictedPositions[particleIndex].xyz;
    float3 vorticity = _Vorticities[particleIndex].xyz;
    if (!IsFiniteFloat3(position) || !IsFiniteFloat3(vorticity))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    int3 cell;
    if (!TryGetSpatialCell(particleIndex, cell))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }
    float3 eta = 0.0f;
    float vorticityMagnitude = length(vorticity);
    [unroll]
    for (int cellOffsetIndex = 0; cellOffsetIndex < 27; cellOffsetIndex++)
    {
        int3 neighborCell = cell + int3(cellOffsetIndex % 3 - 1, (cellOffsetIndex / 3) % 3 - 1, cellOffsetIndex / 9 - 1);
        uint2 range = _CellRanges[HashCell(neighborCell)];
        if (range.x == FLUID_INACTIVE_BUCKET || range.y <= range.x)
            continue;

        uint end = min(range.y, (uint)_ParticleCapacity);
        for (uint sortedIndex = range.x; sortedIndex < end; sortedIndex++)
        {
            uint neighborIndex;
            if (!TryGetNeighbor(sortedIndex, neighborCell, particleIndex, neighborIndex) || neighborIndex == particleIndex)
                continue;

            float neighborDensity = _DensityLambda[neighborIndex].x;
            float3 neighborVorticity = _Vorticities[neighborIndex].xyz;
            if (!IsFiniteFloat(neighborDensity) || neighborDensity <= 1e-6f
                || !IsFiniteFloat3(neighborVorticity))
            {
                continue;
            }

            float3 offset = position - _PredictedPositions[neighborIndex].xyz;
            // eta 是 |omega| 的归一化差分梯度；减去本粒子项才能得到局部变化而非整体尺度偏移。
            eta += (particleMass / neighborDensity)
                * (length(neighborVorticity) - vorticityMagnitude) * SpikyGradient(offset);
        }
    }

    float etaLength = length(eta);
    float3 force = etaLength > 1e-6f ? _Vorticity * cross(eta / etaLength, vorticity) : 0.0f;
    float3 deltaVelocity = force * _DeltaTime;
    if (!IsFiniteFloat3(deltaVelocity))
    {
        _DeltaVelocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    _DeltaVelocities[particleIndex] = float4(deltaVelocity, 0.0f);
}

[numthreads(64, 1, 1)]
void ClampVelocities(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint particleIndex = dispatchThreadId.x;
    if (!IsActive(particleIndex))
        return;

    float3 velocity = _Velocities[particleIndex].xyz;
    if (!IsFiniteFloat3(velocity))
    {
        _Velocities[particleIndex] = 0.0f;
        RecordNumericalError();
        return;
    }

    float speed = length(velocity);
    if (speed > _MaxSpeed && speed > 0.0f)
        velocity *= _MaxSpeed / speed;
    _Velocities[particleIndex] = float4(velocity, 0.0f);
}
