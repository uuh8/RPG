#include "FluidGpuCommon.hlsl"

#define THREADS_PER_GROUP 64

float PositiveCubeRoot(float value)
{
    // Spawn 随机数和粒子数都属于非负域。0 单独返回，其余通过 log2/exp2 求立方根，
    // 避免通用分数次幂在 D3D compiler 中触发“底数可能为负”的 warning。
    return value > 0.0f ? exp2(log2(value) / 3.0f) : 0.0f;
}

RWStructuredBuffer<float4> _Positions;
RWStructuredBuffer<float4> _PredictedPositions;
RWStructuredBuffer<float4> _Velocities;
RWStructuredBuffer<float2> _DensityLambda;
RWStructuredBuffer<uint2> _ParticleMetadata;
RWStructuredBuffer<float4> _DeltaPositions;
struct FluidGpuArchiveSample
{
    float3 position;
    uint materialId;
    float3 velocity;
    uint flags;
};
RWStructuredBuffer<FluidGpuArchiveSample> _ArchiveSamples;
struct FluidGpuRestoreParticle
{
    float3 position;
    uint materialId;
    float3 velocity;
    uint transactionId;
};
struct FluidGpuTransferStatus
{
    uint succeeded;
    uint reservedBase;
    uint particleCount;
    uint transactionId;
};
StructuredBuffer<FluidGpuRestoreParticle> _RestoreParticles;
RWStructuredBuffer<uint> _RestoreReservedIndices;
RWStructuredBuffer<FluidGpuTransferStatus> _TransferStatus;
RWStructuredBuffer<uint2> _SpatialEntries;
RWStructuredBuffer<uint2> _CellRanges;
RWStructuredBuffer<uint> _FreeIndices;
RWStructuredBuffer<uint> _Counters;
StructuredBuffer<FluidGpuSpawnRequest> _SpawnRequests;
struct FluidConsumeCommand
{
    int4 minimumCellAndPadding;
    int4 maximumCellAndParticleCount;
    uint4 materialSeedPadding;
};
StructuredBuffer<FluidConsumeCommand> _ConsumeRequests;
struct FluidConvertCommand
{
    int4 minimumCellAndPadding;
    int4 maximumCellAndParticleCount;
    uint4 sourceTargetSeedPadding;
};
StructuredBuffer<FluidConvertCommand> _ConvertRequests;
RWStructuredBuffer<float4> _GameplaySamples;
RWStructuredBuffer<uint> _StableTickCounters;
RWStructuredBuffer<uint> _WakeRequests;
RWStructuredBuffer<uint> _ActivityCounters;
RWStructuredBuffer<uint> _SolverDispatchArgs;
RWStructuredBuffer<uint> _HashDispatchArgs;
StructuredBuffer<FluidGpuLiquidMaterialParameters> _LiquidMaterialParameters;

int _ParticleCapacity;
int _HashTableCapacity;
int _SpawnRequestCount;
int _ReactionCommandCount;
float4 _WorldOrigin;
float _CellSize;
// 仅供旧 fixture 直接注入 48-byte-era Request；Production DensityPacked Request 总携带 per-material spacing。
float _SpawnRestSpacing;
float4 _ActiveBoundsMin;
float4 _ActiveBoundsMax;
float4 _ArchiveRetainedBoundsMin;
float4 _ArchiveRetainedBoundsMax;
float _SleepVelocityThreshold;
float _SleepDensityErrorThreshold;
float _RestDensity;
int _SleepAfterStableTicks;
int _ParticleGroupCount;
int _HashTableGroupCount;
int _RestoreParticleCount;
int _GameplayReserveParticles;
int _TransferTransactionId;
int _WakeAllInterestParticles;
int _ArchiveIncludeSleepingRetained;
float _DeltaTime;
float _MaxSpeed;
float4 _Gravity;

bool TryPopFreeIndex(out uint particleIndex)
{
    // Compare-Exchange 循环保证多个 Spawn Thread 不会同时拿到同一个 free-stack slot。
    // 后续 PBF 只会读取 active 数据；Pool 的所有权仍由这个 Kernel 唯一改变。
    while (true)
    {
        uint freeCount = _Counters[FLUID_FREE_COUNT_COUNTER];
        if (freeCount == 0u)
        {
            particleIndex = 0u;
            return false;
        }

        uint original;
        InterlockedCompareExchange(
            _Counters[FLUID_FREE_COUNT_COUNTER],
            freeCount,
            freeCount - 1u,
            original);
        if (original == freeCount)
        {
            particleIndex = _FreeIndices[freeCount - 1u];
            return true;
        }
    }

    // HLSL 的 while(true) 对 D3D11 控制流分析器并不总能被证明为全路径 return；
    // 此分支不可达，仅为跨编译器的控制流完整性，不能改变上面的 CAS 语义。
    particleIndex = 0u;
    return false;
}

void AccumulateDroppedParticleCount(uint amount)
{
    if (amount == 0u)
        return;

    // Counter 只用 uint 表示；多个恶意 direct-upload request 的总和不能回绕成较小值。
    // CAS 保留精确的普通累加，超过表达范围时饱和为 UINT_MAX，避免诊断自身产生错误信息。
    while (true)
    {
        uint current = _Counters[FLUID_DROPPED_PARTICLE_COUNTER];
        uint desired = (0xffffffffu - current < amount)
            ? 0xffffffffu
            : current + amount;
        uint original;
        InterlockedCompareExchange(
            _Counters[FLUID_DROPPED_PARTICLE_COUNTER],
            current,
            desired,
            original);
        if (original == current)
            return;
    }
}

float SampleLinearFalloffRadius(float uniformSample)
{
    // 对 3D 球体 rho(r) ∝ 1-r/R，归一化半径 x 的 CDF 是 F(x)=4x^3-3x^4。
    // 固定 12 次 bisection 没有 rejection loop，既确定又有常数时间上界。
    float low = 0.0f;
    float high = 1.0f;
    [unroll]
    for (int iteration = 0; iteration < 12; iteration++)
    {
        float middle = (low + high) * 0.5f;
        float cdf = 4.0f * middle * middle * middle
            - 3.0f * middle * middle * middle * middle;
        if (cdf < uniformSample)
            low = middle;
        else
            high = middle;
    }

    return (low + high) * 0.5f;
}

float3 SpawnOffset(FluidGpuSpawnRequest request, uint localIndex)
{
    uint seed = request.materialSeedFlagsParticleCount.y + localIndex * 747796405u;
    float z = FluidRandom01(seed) * 2.0f - 1.0f;
    float angle = FluidRandom01(seed + 1u) * 6.28318530718f;
    float radial = sqrt(max(0.0f, 1.0f - z * z));
    float3 direction = float3(radial * cos(angle), z, radial * sin(angle));

    // Flag 只改变新粒子的采样密度：linear 遵循 rho(r) ∝ 1-r/R，默认值体积均匀。
    // 两条路径都不会修改已生成粒子的质量/Metadata。
    bool useLinearFalloff = (request.materialSeedFlagsParticleCount.z & 1u) != 0u;
    float radiusSample = FluidRandom01(seed + 2u);
    float distance = useLinearFalloff
        ? SampleLinearFalloffRadius(radiusSample)
        : PositiveCubeRoot(radiusSample);
    return direction * (distance * request.positionRadius.w);
}

float3 PackedLatticeOffset(FluidGpuSpawnRequest request, uint localIndex)
{
    uint particleCount = request.materialSeedFlagsParticleCount.w;
    uint side = (uint)ceil(PositiveCubeRoot((float)particleCount));
    // 浮点 cubic root 在完全立方数附近可能向下舍入；整数校正保证 side^3 始终容纳全部粒子。
    while (side * side * side < particleCount)
        side++;

    uint sideSquared = side * side;
    uint totalSlots = sideSquared * side;
    uint step = sideSquared + side + 1u;
    uint slot = (localIndex * step
        + request.materialSeedFlagsParticleCount.y % totalSlots) % totalSlots;
    uint x = slot % side;
    uint y = (slot / side) % side;
    uint z = slot / sideSquared;
    float center = 0.5f * ((float)side - 1.0f);
    float restSpacing = request.packingParameters.x > 0.0f
        ? request.packingParameters.x
        : _SpawnRestSpacing;
    return (float3((float)x, (float)y, (float)z) - center) * restSpacing;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void InitializePool(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index < (uint)_ParticleCapacity)
    {
        _Positions[index] = float4(0, 0, 0, 0);
        _PredictedPositions[index] = float4(0, 0, 0, 0);
        _Velocities[index] = float4(0, 0, 0, 0);
        _DensityLambda[index] = float2(0, 0);
        _ParticleMetadata[index] = uint2(0, 0);
        _DeltaPositions[index] = float4(0, 0, 0, 0);
        _SpatialEntries[index] = uint2(0xffffffffu, 0xffffffffu);
        _FreeIndices[index] = index;
    }

}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void InitializePoolAuxiliary(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index < (uint)_HashTableCapacity)
        _CellRanges[index] = uint2(0xffffffffu, 0u);

    if (index == 0u)
    {
        _Counters[FLUID_FREE_COUNT_COUNTER] = (uint)_ParticleCapacity;
        _Counters[FLUID_ACTIVE_COUNT_COUNTER] = 0u;
        _Counters[FLUID_DROPPED_PARTICLE_COUNTER] = 0u;
        _Counters[FLUID_NUMERICAL_ERROR_COUNTER] = 0u;
    }
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void InitializeActivity(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index < (uint)_ParticleCapacity)
    {
        _StableTickCounters[index] = 0u;
        _WakeRequests[index] = 0u;
    }
    if (index < 3u)
    {
        _ActivityCounters[index] = 0u;
        _SolverDispatchArgs[index] = index == 0u ? 0u : 1u;
        _HashDispatchArgs[index] = index == 0u ? 0u : 1u;
    }
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void SpawnParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint requestIndex = dispatchThreadId.x;
    if (requestIndex >= (uint)_SpawnRequestCount)
        return;

    FluidGpuSpawnRequest request = _SpawnRequests[requestIndex];
    uint requestedCount = request.materialSeedFlagsParticleCount.w;
    uint boundedCount = min(requestedCount, (uint)_ParticleCapacity);
    // 直接上传可绕过 CPU Validator；先聚合超出 Pool 容量的部分，随后最多循环 capacity 次。
    AccumulateDroppedParticleCount(requestedCount - boundedCount);
    for (uint localIndex = 0u; localIndex < boundedCount; localIndex++)
    {
        uint particleIndex;
        if (!TryPopFreeIndex(particleIndex))
        {
            // Free Stack 一旦耗尽，本 request 的其余元素必然都无法生成；聚合后直接退出，
            // 防止 uint.MaxValue 等恶意请求把一个 Compute Thread 变成无界空转。
            AccumulateDroppedParticleCount(boundedCount - localIndex);
            break;
        }

        bool densityPacked = (request.materialSeedFlagsParticleCount.z & 2u) != 0u;
        float3 offset;
        if (densityPacked)
            offset = PackedLatticeOffset(request, localIndex);
        else
            offset = SpawnOffset(request, localIndex);
        float3 position = request.positionRadius.xyz + offset;
        _Positions[particleIndex] = float4(position, 1.0f);
        _PredictedPositions[particleIndex] = float4(position, 1.0f);
        _Velocities[particleIndex] = float4(request.velocity.xyz, 0.0f);
        _DensityLambda[particleIndex] = float2(0, 0);
        _DeltaPositions[particleIndex] = float4(0, 0, 0, 0);
        _ParticleMetadata[particleIndex] = uint2(
            request.materialSeedFlagsParticleCount.x,
            FLUID_ALIVE_FLAG
                | FLUID_INTEREST_ACTIVE_FLAG
                | FLUID_REQUIRES_SIMULATION_FLAG
                | FLUID_REMOTE_SPAWN_ACTIVE_FLAG);
        uint ignoredActive;
        InterlockedAdd(_Counters[FLUID_ACTIVE_COUNT_COUNTER], 1u, ignoredActive);
    }
}

// 一个 Thread 处理一条低频 Gameplay Command，并用 CAS 抢占 active slot。
// Seed 只旋转扫描起点：同一输入可重复，又不会永远优先消耗低 index 粒子。
[numthreads(1, 1, 1)]
void ConsumeParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint commandIndex = dispatchThreadId.x;
    if (commandIndex >= (uint)_ReactionCommandCount || _CellSize <= 0.0f)
        return;

    FluidConsumeCommand command = _ConsumeRequests[commandIndex];
    uint maximumCount = (uint)command.maximumCellAndParticleCount.w;
    uint consumed = 0u;
    uint start = _ParticleCapacity > 0
        ? command.materialSeedPadding.y % (uint)_ParticleCapacity
        : 0u;
    for (uint offset = 0u; offset < (uint)_ParticleCapacity && consumed < maximumCount; offset++)
    {
        uint particleIndex = (start + offset) % (uint)_ParticleCapacity;
        uint2 metadata = _ParticleMetadata[particleIndex];
        if (!FluidIsAlive(metadata.y)
            || metadata.x != command.materialSeedPadding.x)
        {
            continue;
        }

        int3 globalCell = (int3)floor(
            (_Positions[particleIndex].xyz - _WorldOrigin.xyz) / _CellSize);
        if (any(globalCell < command.minimumCellAndPadding.xyz)
            || any(globalCell > command.maximumCellAndParticleCount.xyz))
        {
            continue;
        }

        uint originalFlags;
        InterlockedCompareExchange(
            _ParticleMetadata[particleIndex].y,
            metadata.y,
            0u,
            originalFlags);
        if (originalFlags != metadata.y)
            continue;

        uint freeIndex;
        InterlockedAdd(_Counters[FLUID_FREE_COUNT_COUNTER], 1u, freeIndex);
        if (freeIndex < (uint)_ParticleCapacity)
            _FreeIndices[freeIndex] = particleIndex;
        uint ignoredActive;
        InterlockedAdd(_Counters[FLUID_ACTIVE_COUNT_COUNTER], 0xffffffffu, ignoredActive);

        _Positions[particleIndex] = float4(0, 0, 0, 0);
        _PredictedPositions[particleIndex] = float4(0, 0, 0, 0);
        _Velocities[particleIndex] = float4(0, 0, 0, 0);
        _DensityLambda[particleIndex] = float2(0, 0);
        _DeltaPositions[particleIndex] = float4(0, 0, 0, 0);
        consumed++;
    }
}

// 原位转换只改变 Material Id，不触碰 Alive/Free Counter，也不移动粒子。
// CAS 让重叠命令只能有一个线程从 Source 成功取得同一粒子的所有权。
[numthreads(1, 1, 1)]
void ConvertParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint commandIndex = dispatchThreadId.x;
    if (commandIndex >= (uint)_ReactionCommandCount || _CellSize <= 0.0f)
        return;

    FluidConvertCommand command = _ConvertRequests[commandIndex];
    uint maximumCount = (uint)command.maximumCellAndParticleCount.w;
    uint converted = 0u;
    uint start = _ParticleCapacity > 0
        ? command.sourceTargetSeedPadding.z % (uint)_ParticleCapacity
        : 0u;
    for (uint offset = 0u; offset < (uint)_ParticleCapacity && converted < maximumCount; offset++)
    {
        uint particleIndex = (start + offset) % (uint)_ParticleCapacity;
        uint2 metadata = _ParticleMetadata[particleIndex];
        if (!FluidIsAlive(metadata.y)
            || metadata.x != command.sourceTargetSeedPadding.x)
        {
            continue;
        }

        int3 globalCell = (int3)floor(
            (_Positions[particleIndex].xyz - _WorldOrigin.xyz) / _CellSize);
        if (any(globalCell < command.minimumCellAndPadding.xyz)
            || any(globalCell > command.maximumCellAndParticleCount.xyz))
        {
            continue;
        }

        uint originalMaterial;
        InterlockedCompareExchange(
            _ParticleMetadata[particleIndex].x,
            command.sourceTargetSeedPadding.x,
            command.sourceTargetSeedPadding.y,
            originalMaterial);
        if (originalMaterial != command.sourceTargetSeedPadding.x)
            continue;

        uint flags = (metadata.y | FLUID_REQUIRES_SIMULATION_FLAG)
            & ~FLUID_SLEEPING_FLAG;
        _ParticleMetadata[particleIndex].y = flags;
        _StableTickCounters[particleIndex] = 0u;
        converted++;
    }
}

[numthreads(1, 1, 1)]
void ClearActivityCounters(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _ActivityCounters[FLUID_AWAKE_ACTIVITY_COUNTER] = 0u;
    _ActivityCounters[FLUID_SLEEPING_ACTIVITY_COUNTER] = 0u;
    _ActivityCounters[FLUID_INTEREST_ACTIVITY_COUNTER] = 0u;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void UpdateParticleActivity(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    uint2 metadata = _ParticleMetadata[index];
    uint flags = metadata.y;
    if (!FluidIsAlive(flags))
    {
        _StableTickCounters[index] = 0u;
        _WakeRequests[index] = 0u;
        return;
    }

    if ((flags & FLUID_ARCHIVE_LOCKED_FLAG) != 0u)
        return;

    float3 position = _Positions[index].xyz;
    bool inside = all(position >= _ActiveBoundsMin.xyz)
        && all(position < _ActiveBoundsMax.xyz);
    if (!inside)
    {
        // Spawn 与本 Activity Pass 发生在同一个 Fixed Tick。若这里无条件降级为 Alive-only，
        // 远处出生的粒子会在第一次 Gravity 前冻结。Remote Lease 只维持到粒子低速且不再过压。
        if ((flags & FLUID_REMOTE_SPAWN_ACTIVE_FLAG) != 0u)
        {
            float speed = length(_Velocities[index].xyz);
            FluidGpuLiquidMaterialParameters material = _LiquidMaterialParameters[metadata.x];
            float restDensity = material.massDensityViscosityPressure.y > 0.0f
                ? material.massDensityViscosityPressure.y
                : _RestDensity;
            float sleepDensityErrorThreshold = material.massDensityViscosityPressure.y > 0.0f
                ? material.cohesionAndSleep.w
                : _SleepDensityErrorThreshold;
            float relativeCompression = (_DensityLambda[index].x - restDensity)
                / max(restDensity, 1e-6f);
            bool stable = speed <= _SleepVelocityThreshold
                && relativeCompression <= sleepDensityErrorThreshold;
            uint stableTicks = _StableTickCounters[index];
            stableTicks = stable
                ? (stableTicks == 0xffffffffu ? 0xffffffffu : stableTicks + 1u)
                : 0u;
            if (stable && stableTicks >= (uint)max(1, _SleepAfterStableTicks))
            {
                flags = FLUID_ALIVE_FLAG;
                _Velocities[index] = 0.0f;
            }
            else
            {
                flags = FLUID_ALIVE_FLAG
                    | FLUID_REMOTE_SPAWN_ACTIVE_FLAG
                    | FLUID_REQUIRES_SIMULATION_FLAG;
            }
            _StableTickCounters[index] = stableTicks;
        }
        else
        {
            flags = FLUID_ALIVE_FLAG;
            _StableTickCounters[index] = 0u;
        }
        _WakeRequests[index] = 0u;
        _ParticleMetadata[index] = uint2(metadata.x, flags);
        if (FluidRequiresSimulation(flags))
        {
            uint ignoredAwake;
            InterlockedAdd(_ActivityCounters[FLUID_AWAKE_ACTIVITY_COUNTER], 1u, ignoredAwake);
        }
        return;
    }

    bool wasInside = (flags & FLUID_INTEREST_ACTIVE_FLAG) != 0u;
    bool wake = _WakeAllInterestParticles != 0 || _WakeRequests[index] != 0u || !wasInside;
    _WakeRequests[index] = 0u;
    uint stableTicks = _StableTickCounters[index];
    if (wake)
    {
        // 一旦进入玩家 Interest，普通 Activity/Sleeping 状态机接管并释放 Remote Lease。
        flags = FLUID_ALIVE_FLAG | FLUID_INTEREST_ACTIVE_FLAG | FLUID_REQUIRES_SIMULATION_FLAG;
        stableTicks = 0u;
    }
    else if ((flags & FLUID_SLEEPING_FLAG) == 0u)
    {
        float speed = length(_Velocities[index].xyz);
        // 自由表面外侧没有邻居，SPH Density 天然低于 Rest Density；把这种欠密度也当成
        // “不稳定”会让水滩边缘永远 Awake，并把微小 Solver 运动放大成 Marching Cubes 抖动。
        // Sleep 只阻止仍受压缩的粒子冻结：低速欠密度表面可休眠，过密内部仍继续释放压力。
        FluidGpuLiquidMaterialParameters material = _LiquidMaterialParameters[metadata.x];
        float restDensity = material.massDensityViscosityPressure.y > 0.0f
            ? material.massDensityViscosityPressure.y
            : _RestDensity;
        float sleepDensityErrorThreshold = material.massDensityViscosityPressure.y > 0.0f
            ? material.cohesionAndSleep.w
            : _SleepDensityErrorThreshold;
        float relativeCompression = (_DensityLambda[index].x - restDensity)
            / max(restDensity, 1e-6f);
        bool stable = speed <= _SleepVelocityThreshold
            && relativeCompression <= sleepDensityErrorThreshold;
        stableTicks = stable
            ? (stableTicks == 0xffffffffu ? 0xffffffffu : stableTicks + 1u)
            : 0u;
        if (stable && stableTicks >= (uint)max(1, _SleepAfterStableTicks))
        {
            flags = FLUID_ALIVE_FLAG | FLUID_INTEREST_ACTIVE_FLAG | FLUID_SLEEPING_FLAG;
            // Sleeping 粒子保留位置并继续参与 Surface/Neighbor Read；清掉阈值内残余速度，
            // 避免后续 Wake 把休眠前的微小切向速度重新带回边缘。
            _Velocities[index] = 0.0f;
        }
        else
            flags = FLUID_ALIVE_FLAG | FLUID_INTEREST_ACTIVE_FLAG | FLUID_REQUIRES_SIMULATION_FLAG;
    }

    _StableTickCounters[index] = stableTicks;
    _ParticleMetadata[index] = uint2(metadata.x, flags);
    uint ignored;
    InterlockedAdd(_ActivityCounters[FLUID_INTEREST_ACTIVITY_COUNTER], 1u, ignored);
    if (FluidRequiresSimulation(flags))
        InterlockedAdd(_ActivityCounters[FLUID_AWAKE_ACTIVITY_COUNTER], 1u, ignored);
    else if ((flags & FLUID_SLEEPING_FLAG) != 0u)
        InterlockedAdd(_ActivityCounters[FLUID_SLEEPING_ACTIVITY_COUNTER], 1u, ignored);
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void LockArchiveCandidates(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity) return;
    uint2 metadata = _ParticleMetadata[index];
    if (!FluidIsAlive(metadata.y) || (metadata.y & FLUID_ARCHIVE_LOCKED_FLAG) != 0u) return;
    float3 position = _Positions[index].xyz;
    bool retained = all(position >= _ArchiveRetainedBoundsMin.xyz)
        && all(position < _ArchiveRetainedBoundsMax.xyz);
    bool retainedSleeping = retained
        && _ArchiveIncludeSleepingRetained != 0
        && (metadata.y & FLUID_SLEEPING_FLAG) != 0u;
    if (!retained || retainedSleeping)
    {
        // 保留锁前 Activity bits，使失败 Cancel 能精确回到 Sleeping/Remote/Active 状态。
        _ParticleMetadata[index].y = metadata.y | FLUID_ARCHIVE_LOCKED_FLAG;
    }
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void PackArchiveSamples(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity) return;
    uint2 metadata = _ParticleMetadata[index];
    FluidGpuArchiveSample sample;
    sample.position = 0.0f; sample.materialId = 0u; sample.velocity = 0.0f; sample.flags = 0u;
    // Readback 同时携带所有 Alive 粒子。CPU 会只聚合 ArchiveLocked 样本，并在本地休眠事务中
    // 验证 Retained Chunk 没有未锁定粒子；这道提交前校验封住 Activity Counter 的异步竞态。
    if (FluidIsAlive(metadata.y))
    {
        sample.position = _Positions[index].xyz;
        sample.materialId = metadata.x;
        sample.velocity = _Velocities[index].xyz;
        sample.flags = metadata.y;
    }
    _ArchiveSamples[index] = sample;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void CancelArchiveLock(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity) return;
    uint2 metadata = _ParticleMetadata[index];
    if ((metadata.y & (FLUID_ALIVE_FLAG | FLUID_ARCHIVE_LOCKED_FLAG))
        == (FLUID_ALIVE_FLAG | FLUID_ARCHIVE_LOCKED_FLAG))
    {
        _ParticleMetadata[index].y = metadata.y & ~FLUID_ARCHIVE_LOCKED_FLAG;
    }
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ReleaseArchiveLockedParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity) return;
    uint original;
    InterlockedExchange(_ParticleMetadata[index].y, 0u, original);
    if ((original & (FLUID_ALIVE_FLAG | FLUID_ARCHIVE_LOCKED_FLAG))
        != (FLUID_ALIVE_FLAG | FLUID_ARCHIVE_LOCKED_FLAG))
    {
        _ParticleMetadata[index].y = original;
        return;
    }

    uint freeIndex;
    InterlockedAdd(_Counters[FLUID_FREE_COUNT_COUNTER], 1u, freeIndex);
    if (freeIndex < (uint)_ParticleCapacity) _FreeIndices[freeIndex] = index;
    uint ignored;
    InterlockedAdd(_Counters[FLUID_ACTIVE_COUNT_COUNTER], 0xffffffffu, ignored);
    _Positions[index] = 0.0f;
    _PredictedPositions[index] = 0.0f;
    _Velocities[index] = 0.0f;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ClearReleasedArchiveAuxiliary(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity || FluidIsAlive(_ParticleMetadata[index].y)) return;
    // 与 Release 分 Kernel 控制 D3D11 的 UAV 数量；同一 Graphics Queue 保证这里在释放之后执行。
    _DensityLambda[index] = 0.0f;
    _DeltaPositions[index] = 0.0f;
    _StableTickCounters[index] = 0u;
    _WakeRequests[index] = 0u;
}

[numthreads(1, 1, 1)]
void ReserveRestoreSlots(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint required = (uint)max(0, _RestoreParticleCount);
    uint reserve = (uint)max(0, _GameplayReserveParticles);
    uint transactionId = (uint)_TransferTransactionId;
    FluidGpuTransferStatus status;
    status.succeeded = 0u;
    status.reservedBase = 0u;
    status.particleCount = required;
    status.transactionId = transactionId;

    uint freeCount = _Counters[FLUID_FREE_COUNT_COUNTER];
    // 加法改写为两次比较，避免 required + reserve 在恶意输入下 uint 回绕。
    if (transactionId != 0u && required > 0u && required <= freeCount
        && reserve <= freeCount - required)
    {
        uint newFreeCount = freeCount - required;
        _Counters[FLUID_FREE_COUNT_COUNTER] = newFreeCount;
        status.succeeded = 1u;
        status.reservedBase = newFreeCount;
    }
    _TransferStatus[0] = status;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void StageRestoreParticlesCore(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint localIndex = dispatchThreadId.x;
    FluidGpuTransferStatus status = _TransferStatus[0];
    if (status.succeeded == 0u || status.transactionId != (uint)_TransferTransactionId
        || localIndex >= status.particleCount) return;
    FluidGpuRestoreParticle particle = _RestoreParticles[localIndex];
    if (particle.transactionId != status.transactionId) return;
    uint slot = _FreeIndices[status.reservedBase + localIndex];
    if (slot >= (uint)_ParticleCapacity) return;
    _RestoreReservedIndices[localIndex] = slot;
    _Positions[slot] = float4(particle.position, 0.0f);
    _PredictedPositions[slot] = float4(particle.position, 0.0f);
    _Velocities[slot] = float4(particle.velocity, 0.0f);
    _ParticleMetadata[slot] = uint2(particle.materialId, FLUID_RESTORE_LOADING_FLAG);
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void StageRestoreParticlesAuxiliary(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint localIndex = dispatchThreadId.x;
    FluidGpuTransferStatus status = _TransferStatus[0];
    if (status.succeeded == 0u || status.transactionId != (uint)_TransferTransactionId
        || localIndex >= status.particleCount) return;
    uint slot = _RestoreReservedIndices[localIndex];
    if (slot >= (uint)_ParticleCapacity) return;
    _DensityLambda[slot] = 0.0f;
    _DeltaPositions[slot] = 0.0f;
    _StableTickCounters[slot] = 0u;
    _WakeRequests[slot] = 0u;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ActivateRestoredParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint localIndex = dispatchThreadId.x;
    FluidGpuTransferStatus status = _TransferStatus[0];
    if (status.succeeded == 0u || status.transactionId != (uint)_TransferTransactionId
        || localIndex >= status.particleCount) return;
    uint slot = _RestoreReservedIndices[localIndex];
    if (slot >= (uint)_ParticleCapacity || _ParticleMetadata[slot].y != FLUID_RESTORE_LOADING_FLAG)
        return;
    float3 position = _Positions[slot].xyz;
    bool inside = all(position >= _ActiveBoundsMin.xyz) && all(position < _ActiveBoundsMax.xyz);
    uint flags = inside
        ? FLUID_ALIVE_FLAG | FLUID_INTEREST_ACTIVE_FLAG | FLUID_REQUIRES_SIMULATION_FLAG
        : FLUID_ALIVE_FLAG | FLUID_REMOTE_SPAWN_ACTIVE_FLAG | FLUID_REQUIRES_SIMULATION_FLAG;
    _ParticleMetadata[slot].y = flags;
    _Positions[slot].w = 1.0f;
    _PredictedPositions[slot].w = 1.0f;
    uint ignored;
    InterlockedAdd(_Counters[FLUID_ACTIVE_COUNT_COUNTER], 1u, ignored);
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void RollbackRestoredParticles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint localIndex = dispatchThreadId.x;
    FluidGpuTransferStatus status = _TransferStatus[0];
    if (status.succeeded == 0u || status.transactionId != (uint)_TransferTransactionId
        || localIndex >= status.particleCount) return;
    uint slot = _RestoreReservedIndices[localIndex];
    if (slot >= (uint)_ParticleCapacity || _ParticleMetadata[slot].y != FLUID_RESTORE_LOADING_FLAG)
        return;
    _ParticleMetadata[slot] = uint2(0u, 0u);
    _Positions[slot] = 0.0f;
    _PredictedPositions[slot] = 0.0f;
    _Velocities[slot] = 0.0f;
    uint freeIndex;
    InterlockedAdd(_Counters[FLUID_FREE_COUNT_COUNTER], 1u, freeIndex);
    if (freeIndex < (uint)_ParticleCapacity) _FreeIndices[freeIndex] = slot;
}

[numthreads(1, 1, 1)]
void WriteSolverDispatchArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint awakeCount = _ActivityCounters[FLUID_AWAKE_ACTIVITY_COUNTER];
    _SolverDispatchArgs[0] = awakeCount == 0u ? 0u : (uint)_ParticleGroupCount;
    _SolverDispatchArgs[1] = 1u;
    _SolverDispatchArgs[2] = 1u;
    _HashDispatchArgs[0] = awakeCount == 0u ? 0u : (uint)_HashTableGroupCount;
    _HashDispatchArgs[1] = 1u;
    _HashDispatchArgs[2] = 1u;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ApplyGravity(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity || !FluidRequiresSimulation(_ParticleMetadata[index].y))
        return;

    float3 velocity = _Velocities[index].xyz + _Gravity.xyz * _DeltaTime;
    float speed = length(velocity);
    if (speed > _MaxSpeed && speed > 0.0f)
        velocity *= _MaxSpeed / speed;
    _Velocities[index] = float4(velocity, 0.0f);
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void PredictPositions(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity || !FluidRequiresSimulation(_ParticleMetadata[index].y))
        return;

    _PredictedPositions[index] = float4(
        _Positions[index].xyz + _Velocities[index].xyz * _DeltaTime,
        1.0f);
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void CommitPositions(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity || !FluidRequiresSimulation(_ParticleMetadata[index].y))
        return;

    // Task 2 到此为止：只提交预测位置，尚未执行任何 PBF density/neighbor constraint。
    _Positions[index] = _PredictedPositions[index];
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void PackGameplaySamples(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    uint2 metadata = _ParticleMetadata[index];
    bool active = FluidIsAlive(metadata.y);
    // tag=0 是 inactive；active 使用 materialId+1，避免 materialId=0 与 inactive 混淆。
    float tag = active ? (float)(metadata.x + 1u) : 0.0f;
    _GameplaySamples[index] = float4(_Positions[index].xyz, tag);
}
