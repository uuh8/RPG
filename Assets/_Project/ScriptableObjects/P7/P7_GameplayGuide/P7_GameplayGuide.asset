  m_Script: {fileID: 11500000, guid: e4d338f44c3d5bd498b1925a6e04bf17, type: 3}
  m_Name: P7_GameplayGuide
  m_EditorClassIdentifier: Game.UI::Game.UI.GameplayGuideDefinition
  Pages:
  - Title: "\u547D\u8FD0\u5728\u6B64\u843D\u7B14"
    Body: "\u6C89\u5BC2\u5DF2\u4E45\u7684\u5143\u7D20\u56DE\u5ECA\u518D\u6B21\u82CF\u9192\uFF0C\u800C\u4F60\uFF0C\u662F\u56DE\u5E94\u5B83\u53EC\u5524\u7684\u4EBA\u3002\r\n\r\n\u524D\u65B9\u5171\u6709\u56DB\u5EA7\u8BD5\u70BC\u4E4B\u95E8\u3002\u53EA\u6709\u51FB\u8D25\u533A\u57DF\u5185\u7684\u6240\u6709\u654C\u4EBA\uFF0C\u5C01\u9501\u9053\u8DEF\u7684\u529B\u91CF\u624D\u4F1A\u6D88\u6563\u3002\r\n\r\n\u8D8A\u8FC7\u6700\u540E\u4E00\u9053\u8BD5\u70BC\uFF0C\u53D6\u56DE\u6563\u843D\u4E8E\u6B64\u7684\u6CD5\u672F\uFF0C\u7136\u540E\u8E0F\u5165\u4F20\u9001\u95E8\u3002\r\n\r\n\u95E8\u7684\u53E6\u4E00\u7AEF\uFF0C\u6709\u67D0\u79CD\u5F3A\u5927\u7684\u610F\u5FD7\u6B63\u5728\u7B49\u5F85\u3002\r\n\r\n\u8FD9\u6BB5\u65C5\u7A0B\u4F1A\u5982\u4F55\u7ED3\u675F\uFF0C\u5C1A\u672A\u88AB\u547D\u8FD0\u5199\u4E0B\u3002"
  - Title: "\u8BA9\u811A\u6B65\u5148\u4E8E\u5492\u8BED"
    Body: "\u771F\u6B63\u7684\u65BD\u6CD5\u8005\uFF0C\u4E0D\u53EA\u9700\u8981\u9A7E\u9A6D\u5143\u7D20\uFF0C\u4E5F\u5FC5\u987B\u5148\u638C\u63A7\u81EA\u5DF1\u7684\u811A\u6B65\u3002\r\n\r\nWASD
      / \u65B9\u5411\u952E \u79FB\u52A8\u89D2\u8272.\r\n\r\n\u79FB\u52A8\u9F20\u6807
      \u8F6C\u52A8\u89C6\u89D2\uFF0C\u51B3\u5B9A\u524D\u8FDB\u4E0E\u65BD\u6CD5\u7684\u65B9\u5411.\r\n\r\n\u9F20\u6807\u5DE6\u952E
      \u65BD\u653E\u5F53\u524D\u6CD5\u6756\u4E2D\u7684\u6CD5\u672F.\r\n\r\nSpace
      \u8DF3\u8DC3\uFF1B\u5728\u7A7A\u4E2D\u518D\u6B21\u6309\u4E0B\uFF0C\u53EF\u5B8C\u6210\u4E8C\u6BB5\u8DF3.\r\n\r\nLeft
      Shift / \u9F20\u6807\u53F3\u952E \u5411\u5F53\u524D\u671D\u5411\u51B2\u523A\uFF1B\u6BCF\u6B21\u6EDE\u7A7A\u671F\u95F4\uFF0C\u4E5F\u53EF\u4EE5\u8FDB\u884C\u4E00\u6B21\u7A7A\u4E2D\u51B2\u523A.\r\n\r\nTab
      \u6253\u5F00\u6216\u5173\u95ED\u6CD5\u6756\u7F16\u8F91\u5668.\r\n\r\nEsc \u6253\u5F00\u6682\u505C\u83DC\u5355.\r\n\r\n\u5F53\u5371\u9669\u903C\u8FD1\u65F6\uFF0C\u8DDD\u79BB\u4E0E\u4F4D\u7F6E\uFF0C\u5F80\u5F80\u6BD4\u4F24\u5BB3\u6570\u5B57\u66F4\u5148\u51B3\u5B9A\u751F\u6B7B\u3002"
  - Title: "\u6CD5\u6756\u4F1A\u5FE0\u5B9E\u6267\u884C\u4F60\u7684\u610F\u5FD7"
    Body: "\u6CD5\u6756\u5E76\u4E0D\u7406\u89E3\u5947\u8FF9\uFF0C\u5B83\u53EA\u4F1A\u5FE0\u5B9E\u5730\u6267\u884C\u5176\u4E2D\u7684\u6BCF\u4E00\u9053\u6307\u4EE4\u3002\r\n\r\n\u6295\u5C04\u7269\uFF1A\u8BA9\u4E00\u4E2A\u5C04\u51FB\u6216\u9759\u6001\u6CD5\u672F\u5728\u4E16\u754C\u4E2D\u663E\u73B0\u3002\r\n\r\n\u6CD5\u672F\u4FEE\u6B63\uFF1A\u6539\u53D8\u4F4D\u4E8E\u5B83\u4E4B\u540E\u7684\u6CD5\u672F\u3002\u4F24\u5BB3\u3001\u901F\u5EA6\u3001\u8F68\u8FF9\u4E0E\u5F62\u6001\uFF0C\u90FD\u53EF\u80FD\u56E0\u6B64\u4E0D\u540C\u3002\r\n\r\n\u591A\u91CD\u65BD\u6CD5\uFF1A\u6269\u5C55\u6CD5\u6756\u7684\u89E6\u53D1\u6B21\u6570\uFF0C\u4F7F\u6CD5\u6756\u53EF\u4EE5\u540C\u65F6\u6267\u884C\u66F4\u591A\u6CD5\u672F\u3002\r\n\r\n\u89E6\u53D1/\u5EF6\u8FDF\u7C7B\u6295\u5C04\u7269\uFF1A\u5C06\u4E00\u6BB5\u5B8C\u6574\u6CD5\u672F\u5C01\u5B58\u5728\u6295\u5C04\u7269\u4E2D\uFF0C\u7B49\u5F85\u547D\u4E2D\u6216\u8BA1\u65F6\u7ED3\u675F\u540E\u518D\u88AB\u91CA\u653E\u3002\r\n\r\n\u628A\u4E0A\u65B9\u6CD5\u672F\u62D6\u5165\u6CD5\u6756\u4E2D\uFF0C\u5373\u53EF\u91CD\u5199\u6CD5\u6756\u7684\u65BD\u6CD5\u987A\u5E8F\u3002\u540C\u6837\u7684\u6CD5\u672F\uFF0C\u53EA\u56E0\u6392\u5217\u4E0D\u540C\uFF0C\u4FBF\u53EF\u80FD\u5BFC\u5411\u622A\u7136\u4E0D\u540C\u7684\u7ED3\u5C40\u3002\r\n\r\n\u987A\u5E8F\uFF0C\u5C31\u662F\u4F60\u7684\u5492\u8BED\u3002"
